generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────

enum UserRole {
  BRAND
  PARTICIPANT
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum StudyType {
  ONE_ON_ONE
  FOCUS_GROUP
}

enum StudyStatus {
  DRAFT
  ACTIVE
  MATCHING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  INVITED
  CONFIRMED
  REJECTED
  COMPLETED
  NO_SHOW
}

enum RewardType {
  CASH
  VOUCHER
}

enum RewardStatus {
  PENDING
  PROCESSING
  PAID
  REVEALED
  FAILED
}

/// Niveau d'accès d'un participant.
/// STANDARD : la marque l'accepte elle-même, un crédit est débité.
/// ON_REQUEST : profil exceptionnel. Aucun crédit ne peut l'acheter — la marque
/// dépose une demande et le prix se négocie. Ces profils arrivent par Lucas.
enum AccessTier {
  STANDARD
  ON_REQUEST
}

enum CreditTransactionType {
  PURCHASE
  CONSUME
  REFUND
}

enum MessageSenderType {
  BRAND
  ADMIN
  PARTICIPANT
}

// ─── CORE TABLES ─────────────────────────────────────────

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  role       UserRole
  supabaseId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  brandProfile       BrandProfile?
  participantProfile ParticipantProfile?

  @@map("users")
}

model BrandProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName      String
  industry         String?
  website          String?
  logoUrl          String?
  contactFirstName String?
  contactLastName  String?
  contactTitle     String?
  isVerified       Boolean @default(false)
  isActivated      Boolean @default(false)
  /// Contrôle de l'adresse du domaine prouvé (email confirmé, Google ou LinkedIn).
  domainVerifiedAt DateTime?

  stripeCustomerId String?
  credits          Int     @default(0)

  creditTransactions CreditTransaction[]
  studies            Study[]
  messages           Message[]
  profileRequests    ProfileRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brand_profiles")
}

model ParticipantProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identité
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  city        String?
  country     String    @default("FR")
  photoUrl    String?

  // Carrière & expertise
  profession          String?
  yearsOfExperience   Int?
  professionalBio     String?   @db.Text

  // Bio générale
  bio String? @db.Text

  // Social
  linkedinUrl  String?
  instagramUrl String?
  tiktokUrl    String?

  // Influence
  followerRange        String?   // "0", "1k-5k", "5k-20k", "20k-100k", "100k+"
  isInfluencerDeclared Boolean?
  influenceNiche       String?

  // Shopping & style
  shoppingBudgetRange String?   // "0-100€", "100-300€", "300-600€", "600€+"
  shoppingChannels    String[]  // ["retail", "luxury", "resale", "online", ...]
  shoppingFrequency   String?
  isEarlyAdopter      Boolean?

  // Préférences
  rewardPreference String?   // "CASH" | "VOUCHER"
  languages        String[]  @default(["fr"])
  availability     Json?

  // Réponses du tunnel d'onboarding (stockées en JSON)
  screenerAnswers Json?

  // Intérêts & affinités
  interests       String[]
  brandAffinities String[]

  // ─── Tunnel de qualification Rarelyst ───────────────────
  onboardingStep     Int     @default(0)
  onboardingStatus   String  @default("incomplete") // "incomplete" | "complete"
  preferredLanguage  String  @default("fr")

  gender             String?
  employmentStatus   String?
  educationLevel     String?
  householdIncome    String?
  ethnicity          String?

  macroUniverses      String[] // univers macro sélectionnés
  engagementTypes     String[] // types d'engagement avec les marques
  selfProfileType     String?  // auto-identification: industry_insider, early_adopter, ...
  behavioralChecklist String[] // items comportementaux cochés

  adaptiveAnswers    Json?     // réponses aux questions adaptatives (par type)
  expertAnswers      Json?     // 3 questions expertes universelles

  preferredFormat    String?   // "one_on_one" | "focus_group" | "both"
  interviewLanguages String[]

  agreedToCodeOfConduct Boolean @default(false)

  // Segment choisi en tête de tunnel : pro | consumer | creator | hybrid
  segment          String?
  // Parcours pro (segment pro ou hybrid), à la manière de Respondent
  proRole          String?
  proSector        String?
  proYears         String?
  proCompany       String?
  // Auto-déclarations explicites (0-3 par trait) et la preuve donnée en une ligne
  selfTraits       Json?
  traitProofs      Json?
  // Liens publics lus par l'IA
  websiteUrl       String?
  otherLinks       String[] @default([])
  linksAnalysis    Json?

  cvUrl            String?
  portfolioUrl     String?
  cvAnalysis       String? @db.Text // synthèse IA du CV / portfolio uploadé
  linkedinVerified Boolean @default(false)

  // Résumé présentable, VISIBLE par les marques (≠ ghost file interne)
  brandSummary     String? @db.Text

  profileScore Int    @default(0)
  profileLevel String @default("bronze") // bronze | silver | gold | platine

  // Vérification
  idVerificationStatus VerificationStatus @default(PENDING)
  idDocumentUrl        String?
  idVerifiedAt         DateTime?
  idVerifiedByAdminId  String?

  // Qualité
  participationCount Int     @default(0)
  averageRating      Float?
  accessTier         AccessTier @default(STANDARD)
  /// Palier de prix imposé par l'admin (averti | initie | rare) ; sinon calculé.
  priceTier            String?
  /// Prix fixé à la main, en crédits ; prime sur le calcul automatique.
  priceOverrideCredits Int?
  /// Emploi vérifié : un code envoyé à l'adresse professionnelle.
  workEmail              String?
  workEmailVerifiedAt    DateTime?
  workEmailCodeHash      String?
  workEmailCodeExpiresAt DateTime?
  /// Ce que la marque lit à la place du prix, ex. « Sur demande · 48 h de délai ».
  accessNote         String?
  profileRequests    ProfileRequest[]

  isBlacklisted      Boolean @default(false)
  blacklistReason    String?

  // Stripe Connect
  stripeConnectId     String?
  stripeConnectStatus String?

  applications Application[]
  rewards      Reward[]
  adminNotes   AdminNote[]
  messages     Message[]
  ghostFile    ParticipantGhostFile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("participant_profiles")
}

// ─── GHOST FILE (IA) ─────────────────────────────────────

model ParticipantGhostFile {
  id                   String             @id @default(cuid())
  participantProfileId String             @unique
  participantProfile   ParticipantProfile @relation(fields: [participantProfileId], references: [id], onDelete: Cascade)

  // Scores IA (1-10)
  expertiseScore      Int?
  vocabularyScore     Int?
  consistencyScore    Int?
  earlyAdopterScore   Int?
  influenceScore      Int?
  authenticityScore   Int?
  overallQualityScore Int?

  // Classification
  profileType         String?  // "expert", "insider", "influencer", "creative", "enthusiast"
  primaryExpertise    String?  // "mode", "luxe", "streetwear", "beauté", "retail", etc.
  secondaryExpertises String[]
  generationTag       String?  // "Gen Z", "Millennial", "Gen X"
  influenceTier       String?  // "nano", "micro", "macro", "none"

  // Insights qualitatifs
  redFlags             String[]
  aiProfileSummary     String   @db.Text
  aiStrengths          String[]
  aiWeaknesses         String[]
  aiBestStudyTypes     String[]
  aiRecommendedBrands  String[]

  // Tags invisibles — vocabulaire normalisé pour le moteur de recherche marques.
  // Jamais affichés à la marque ni au participant.
  aiTags               String[] @default([])

  // Comportements confirmés par l'IA à partir des preuves — jamais sur simple
  // déclaration. Clés fixes (voir lib/participants/badges.ts).
  behaviours           String[] @default([])

  // Meta
  generatedAt     DateTime @default(now())
  lastUpdatedAt   DateTime @updatedAt
  aiModelUsed     String   @default("claude-sonnet-5")
  processingStatus String  @default("pending") // "pending" | "processing" | "done" | "error"

  @@map("participant_ghost_files")
}

// ─── CREDITS ─────────────────────────────────────────────

model CreditTransaction {
  id             String       @id @default(cuid())
  brandProfileId String
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id])

  type                  CreditTransactionType
  amount                Int
  balanceAfter          Int
  description           String?
  stripePaymentIntentId String?
  studyId               String?
  study                 Study? @relation(fields: [studyId], references: [id])

  createdAt DateTime @default(now())

  @@map("credit_transactions")
}

// ─── STUDIES ─────────────────────────────────────────────

model Study {
  id             String       @id @default(cuid())
  brandProfileId String
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id])

  title     String
  objective String      @db.Text
  studyType StudyType   @default(ONE_ON_ONE)
  status    StudyStatus @default(DRAFT)

  targetParticipantCount Int
  confirmedCount         Int @default(0)

  deadlineAt        DateTime?
  interviewDuration Int      @default(30)
  preferredLanguage String   @default("fr")

  rewardAmount Int
  rewardType   RewardType @default(CASH)
  voucherBrand String?

  targetCriteria    Json
  exclusionCriteria Json?

  focusGroupSize     Int?
  focusGroupSessions Int?

  adminNotes      String? @db.Text
  creditsConsumed Int     @default(0)

  timeSlots          StudyTimeSlot[]
  applications       Application[]
  profileRequests    ProfileRequest[]
  messages           Message[]
  creditTransactions CreditTransaction[]
  report             StudyReport?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("studies")
}

model StudyTimeSlot {
  id      String @id @default(cuid())
  studyId String
  study   Study  @relation(fields: [studyId], references: [id])

  startTime   DateTime
  endTime     DateTime
  capacity    Int     @default(1)
  bookedCount Int     @default(0)
  isAvailable Boolean @default(true)

  interviews Interview[]

  createdAt DateTime @default(now())

  @@map("study_time_slots")
}

// ─── RAPPORT IA ──────────────────────────────────────────

model StudyReport {
  id      String @id @default(cuid())
  studyId String @unique
  study   Study  @relation(fields: [studyId], references: [id], onDelete: Cascade)

  markdownContent    String   @db.Text
  structuredContent  Json?    // Rapport structuré multi-catégories (onglets)
  generatedAt        DateTime @default(now())
  generatedByAdminId String?
  aiModelUsed        String   @default("claude-sonnet-5")
  pdfUrl             String?

  @@map("study_reports")
}

// ─── APPLICATIONS & INTERVIEWS ───────────────────────────

model Application {
  id                   String             @id @default(cuid())
  studyId              String
  study                Study              @relation(fields: [studyId], references: [id])
  participantProfileId String
  participantProfile   ParticipantProfile @relation(fields: [participantProfileId], references: [id])

  status ApplicationStatus @default(PENDING)

  adminScore      Int?
  adminMatchNote  String?
  applicationNote String? @db.Text

  brandAccepted Boolean?
  brandNote     String?

  // Prix figé quand la marque accepte : ce qu'elle a payé et ce que touchera
  // le participant, avec le détail du calcul.
  priceCredits        Int?
  participantPayCents Int?
  priceBreakdown      Json?

  // Créneaux proposés (JSON: [{ startTime: ISO, note?: string, proposedBy?: "participant" | "admin" }]).
  // Entretien individuel : le participant propose, la marque choisit.
  // Sans `proposedBy`, un créneau vient de l'admin (ancien fonctionnement).
  proposedSlots Json?

  // Consentement explicite du participant à l'enregistrement (RGPD).
  recordingConsentAt DateTime?

  interview Interview?
  reward    Reward?

  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studyId, participantProfileId])
  @@map("applications")
}

model Interview {
  id            String         @id @default(cuid())
  studyId       String
  applicationId String         @unique
  application   Application    @relation(fields: [applicationId], references: [id])
  timeSlotId    String?
  timeSlot      StudyTimeSlot? @relation(fields: [timeSlotId], references: [id])

  scheduledAt     DateTime
  durationMinutes Int     @default(30)
  videoLink       String?
  hostRoomUrl     String?
  wherebyMeetingId String?
  wherebyRoomName  String?  // ex "/470c1e94-..." — clé de matching des webhooks
  status          String  @default("scheduled")

  // Enregistrement & transcription (pipeline auto)
  recordingStatus String?   // "pending" | "recording" | "ready" | "failed"
  recordingUrl    String?   @db.Text
  // Les liens d'accès Whereby expirent : on garde l'id pour en générer un frais.
  recordingId     String?
  transcriptStatus String?  // "pending" | "processing" | "done" | "failed"
  transcriptId    String?   // id du job AssemblyAI
  transcript      String?   @db.Text

  completedAt   DateTime?
  brandRating     Int?
  brandFeedback   String?
  brandReviewTags String[]  @default([])
  brandReviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("interviews")
}

// ─── REWARDS ─────────────────────────────────────────────

model Reward {
  id                   String             @id @default(cuid())
  applicationId        String             @unique
  application          Application        @relation(fields: [applicationId], references: [id])
  participantProfileId String
  participantProfile   ParticipantProfile @relation(fields: [participantProfileId], references: [id])

  type   RewardType
  status RewardStatus @default(PENDING)

  amountCents      Int
  stripeTransferId String?
  paidAt           DateTime?

  voucherCode       String?
  voucherBrand      String?
  voucherRevealedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rewards")
}

// ─── MESSAGING ────────────────────────────────────────────

model Message {
  id      String @id @default(cuid())
  studyId String
  study   Study  @relation(fields: [studyId], references: [id])

  senderType           MessageSenderType
  brandProfileId       String?
  brandProfile         BrandProfile?       @relation(fields: [brandProfileId], references: [id])
  participantProfileId String?
  participantProfile   ParticipantProfile? @relation(fields: [participantProfileId], references: [id])

  content String  @db.Text
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("messages")
}

// ─── ADMIN ────────────────────────────────────────────────

model AdminNote {
  id                   String             @id @default(cuid())
  participantProfileId String
  participantProfile   ParticipantProfile @relation(fields: [participantProfileId], references: [id])

  note      String   @db.Text
  createdAt DateTime @default(now())

  @@map("admin_notes")
}

// ─── INVITE CODES ─────────────────────────────────────────

model InviteCode {
  id                   String    @id @default(cuid())
  code                 String    @unique
  label                String?
  usedAt               DateTime?
  usedByBrandProfileId String?
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())

  @@map("invite_codes")
}


/// Demande d'accès à un profil « sur demande ».
/// Elle ne débite aucun crédit et ne crée pas de candidature : elle ouvre une
/// conversation entre la marque et Rarelyst.
model ProfileRequest {
  id                   String @id @default(cuid())
  brandProfileId       String
  participantProfileId String
  studyId              String?

  message    String?
  status     String  @default("pending") // pending | accepted | declined
  adminReply String?

  brandProfile       BrandProfile       @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  participantProfile ParticipantProfile @relation(fields: [participantProfileId], references: [id], onDelete: Cascade)
  study              Study?             @relation(fields: [studyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandProfileId])
  @@index([status])
  @@map("profile_requests")
}

/// Réglages du moteur de prix (une seule ligne, id = "default").
model PricingConfig {
  id        String   @id
  data      Json
  updatedAt DateTime @default(now()) @updatedAt

  @@map("pricing_config")
}
